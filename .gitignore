# ============================================================
# Gitignore - Gestão de Espaços (Full-Stack)
# ============================================================

# Dependências do Node.js
node_modules/
.pnp
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# MongoDB local
mongo-data/
*.sock
*.lock
*.wt
WiredTiger*
journal/

# Next.js / Frontend / Build
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Cache
.cache/
.npm/
.eslintcache
.turbo/

# Variáveis de ambiente e segredos
.env
.env.*
api/.env
frontend/.env
!/.env.example
!/api/.env.example
!/frontend/.env.example

# Testes e cobertura
coverage/
*.lcov

# Logs
*.log
logs/

# IDEs e Editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Sistema Operacional
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Deploy
.vercel/