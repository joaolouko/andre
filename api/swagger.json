          "ADMIN",
          "RECEPTION"
        ],
        "responses": {
          "200": {
            "description": "Contagens e últimas reservas em formato canônico"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Papel sem permissão"
          }
        }
      }
    },
    "/usuarios": {
