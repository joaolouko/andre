  "info": {
    "title": "API de Reservas de Espaços",
    "version": "1.3.0",
    "description": "API full-stack de gestão de espaços com perfis ADMIN, CLIENT e RECEPTION, solicitações, agenda, bloqueios e MongoDB local."
  },
  "servers": [
    {
      "url": "http://localhost:3001"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Autenticação"
    },
    {
      "name": "Dashboard"
    },
    {
      "name": "Usuários"
    },
    {
      "name": "Empresas"
    },
    {
      "name": "Espaços"
    },
    {
      "name": "Disponibilidades"
    },
    {
      "name": "Reservas"
    },
    {
      "name": "Agenda"
    },
    {
      "name": "Bloqueios"
    },
    {
      "name": "Portal do solicitante"
    }
