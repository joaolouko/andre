                    "type": "string",
                    "example": "10:00"
                  },
                  "horaFim": {
                    "type": "string",
                    "example": "12:00"
                  },
                  "status": {
                    "type": "string",
                    "example": "confirmada",
                    "default": "confirmada"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reserva criada"
          }
        }
