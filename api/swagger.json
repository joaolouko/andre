        },
        "responses": {
          "201": {
            "description": "Usuário criado sem password_hash"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "409": {
            "description": "Conflito: já existe um cadastro com o mesmo identificador único."
          }
        }
      }
    },
    "/usuarios/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "get": {
        "tags": [
