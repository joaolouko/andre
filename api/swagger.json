{
  "openapi": "3.0.0",
  "info": {
    "title": "API de Reservas de Espaços",
    "version": "1.0.0",
    "description": "API de gestão de espaços, empresas, disponibilidades, reservas e usuários"
  },
  "servers": [
    {
      "url": "http://localhost:3001"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Autentica um usuário pelo email e senha",
        "tags": [
          "Autenticação"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "senha"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "joao@email.com"
                  },
                  "senha": {
                    "type": "string",
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticação realizada com sucesso"
          },
          "400": {
            "description": "Parâmetros obrigatórios ausentes"
          },
          "401": {
            "description": "Credenciais inválidas"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Retorna as informações do usuário autenticado atual",
        "tags": [
          "Autenticação"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": false,
            "schema": {
              "type": "string",
              "example": "Bearer <token>"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dados do usuário autenticado"
          },
          "401": {
            "description": "Não autorizado ou token ausente/inválido"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Encerra a sessão do usuário",
        "tags": [
          "Autenticação"
        ],
        "responses": {
          "200": {
            "description": "Sessão encerrada com sucesso"
          }
        }
      }
    },
    "/dashboard/stats": {
      "get": {
        "summary": "Retorna estatísticas gerais e indicadores do sistema",
        "tags": [
          "Dashboard"
        ],
        "responses": {
          "200": {
            "description": "Indicadores do painel administrativo"
          }
        }
      }
    },
