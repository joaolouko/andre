                  "data": {
                    "type": "string",
                    "format": "date",
                    "example": "2026-10-01"
                  },
                  "horaInicio": {
                    "type": "string",
                    "example": "08:00"
                  },
                  "horaFim": {
                    "type": "string",
                    "example": "18:00"
