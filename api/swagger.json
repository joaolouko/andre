              "schema": {
                "type": "object",
                "required": [
                  "usuarioId",
                  "espacoId",
                  "data",
                  "horaInicio",
                  "horaFim"
                ],
                "properties": {
                  "usuarioId": {
                    "type": "integer",
                    "example": 1
